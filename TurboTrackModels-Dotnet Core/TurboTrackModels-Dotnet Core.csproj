<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>TurboTrackModels_Dotnet_Core</RootNamespace>
      <UserSecretsId>4414d4f8-bf72-47ac-81ad-f04472faee7d</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
        <PackageReference Include="ClosedXML" Version="0.105.0" />
        <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="35.1.43" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Scalextric Car Images/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
