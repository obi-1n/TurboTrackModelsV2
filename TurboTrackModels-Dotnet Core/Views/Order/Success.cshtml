@* Order Success View - Displays order confirmation details after successful payment *@
@model TurboTrackModels_Dotnet_Core.Models.Order
@{
    ViewBag.Title = "Order Success";
}

<style>
    .success-container {
        padding: 60px 0;
        min-height: 80vh;
    }

    .success-card {
        background-color: #fff;
        border-radius: 15px;
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        max-width: 800px;
        margin: 0 auto;
    }

    .success-header {
        background-color: #f72f35;
        padding: 40px 30px;
        text-align: center;
        border-bottom: 1px solid #d6282d;
    }

    .success-icon {
        color: white;
        font-size: 5rem;
        margin-bottom: 20px;
        animation: scaleIn 0.5s ease-out;
    }

    @@keyframes scaleIn {
        0% { transform: scale(0); }
        80% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }

    .success-header h2 {
        color: white !important;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .success-body {
        padding: 40px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
        background: #f9f9f9;
        padding: 20px;
        border-radius: 10px;
    }

    .info-item label {
        display: block;
        color: #888;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }

    .info-item span {
        display: block;
        color: #333;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .order-items-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 20px;
        color: #333;
        border-bottom: 2px solid #f72f35;
        display: inline-block;
        padding-bottom: 5px;
    }

    .success-table {
        width: 100%;
        margin-bottom: 30px;
    }

    .success-table th {
        font-weight: 600;
        color: #666;
        border-bottom: 1px solid #eee;
        padding: 10px 0;
    }

    .success-table td {
        padding: 15px 0;
        border-bottom: 1px solid #f9f9f9;
        color: #444;
    }

    .total-row {
        font-size: 1.2rem;
        font-weight: 800;
        color: #f72f35;
    }

    .btn-return {
        background-color: #f72f35;
        border: none;
        border-radius: 5px;
        color: white;
        font-weight: 700;
        padding: 15px 30px;
        display: inline-block;
        text-decoration: none;
        transition: background-color 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-return:hover {
        background-color: #d6282d;
        color: white;
        text-decoration: none;
    }
</style>

<div class="success-container">
    <div class="container">
        <div class="success-card">
            <div class="success-header">
                <div class="success-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h2>Order Confirmed!</h2>
                <p class="text-white-50">Thank you for your purchase. Your order has been successfully placed.</p>
            </div>
            
            <div class="success-body">
                <div class="info-grid">
                    <div class="info-item">
                        <label>Order Number</label>
                        <span>#@Model.OrderId</span>
                    </div>
                    <div class="info-item">
                        <label>Date</label>
                        <span>@Model.OrderDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="info-item">
                        <label>Status</label>
                        <span>@Model.Status</span>
                    </div>
                </div>

                <h3 class="order-items-title">Items Ordered</h3>
                <div class="table-responsive">
                    <table class="success-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@item.Product.ProductName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">&pound;@((item.UnitPrice * item.Quantity).ToString("N2"))</td>
                                </tr>
                            }
                            @if (Model.ShippingCost != 0)
                            {
                                <tr>
                                    <td colspan="2">Shipping</td>
                                    <td class="text-end">&pound;@Model.ShippingCost.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="total-row">
                                <td colspan="2" class="text-end pt-3">Grand Total</td>
                                <td class="text-end pt-3">&pound;@Model.TotalCost.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="text-center mt-4">
                    <p class="mb-4">A confirmation email has been sent to your registered email address.</p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-return">Return to Store</a>
                </div>
            </div>
        </div>
    </div>
</div>
