@model IEnumerable<TurboTrackModels_Dotnet_Core.Models.CustomerProfile>
@{
    ViewBag.Title = "Select Customer";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/cart.css" />
}

<div class="cart-container">
    <div class="container">
        <div class="cart-card p-4">
            <h2 class="mb-4">Select Customer</h2>
            <p>Please select the customer who is placing this order.</p>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>@customer.User.FirstName @customer.User.LastName</td>
                                <td>@customer.User.Email</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(customer.Street))
                                    {
                                        @customer.Street@:, @customer.Town, @customer.PostCode
                                    }
                                    else
                                    {
                                        <span class="text-muted">No address on file</span>
                                    }
                                </td>
                                <td>
                                    @using (Html.BeginForm("SelectCustomer", "Order", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="customerId" value="@customer.CustomerID" />
                                        <button type="submit" class="btn btn-sm btn-primary">Select</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("ShoppingCart", "ShoppingCart")" class="btn btn-outline-secondary">Back to Cart</a>
            </div>
        </div>
    </div>
</div>
