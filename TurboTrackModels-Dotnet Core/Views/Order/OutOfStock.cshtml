@model IEnumerable<TurboTrackModels_Dotnet_Core.Models.Product>
@{
    ViewBag.Title = "Sorry, Out of Stock";
}

<main>
    <div class="alert alert-warning">
        <h2>@ViewBag.Title</h2>
        <p>Some items in your cart are currently out of stock or requested quantity exceeds available stock. We apologize for the inconvenience.</p>
    </div>

    <h4>Out of Stock Items:</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Available Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductName</td>
                    <td>@product.StockLevel</td>
                    <td>
                        <form asp-controller="Wishlist" asp-action="Add" method="post">
                            <input type="hidden" name="productId" value="@product.ProductId" />
                            <button type="submit" class="btn btn-outline-primary">Add to Wishlist</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a href="@Url.Action("ShoppingCart", "ShoppingCart")" class="btn btn-primary">Return to Shopping Cart</a>
    </div>
</main>
