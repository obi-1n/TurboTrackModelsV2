@* Checkout View - Displays order summary and handles secure Stripe payment *@
@model TurboTrackModels_Dotnet_Core.Models.ShoppingCart
@{
    ViewBag.Title = "Checkout";
}

<style>
    .checkout-container {
        padding: 40px 0;
        min-height: 80vh;
    }

    .checkout-card {
        background-color: #fff;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .checkout-header {
        background-color: #f72f35;
        padding: 20px 30px;
        border-bottom: 1px solid #d6282d;
    }

    .checkout-header h2 {
        color: white !important;
        margin: 0;
        font-weight: 700;
    }

    .checkout-body {
        padding: 30px;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 20px;
        color: #333;
        border-bottom: 2px solid #f72f35;
        display: inline-block;
        padding-bottom: 5px;
    }

    .order-summary-table {
        width: 100%;
        margin-bottom: 20px;
    }

    .order-summary-table th {
        font-weight: 600;
        color: #666;
        border-bottom: 1px solid #eee;
        padding: 10px 0;
    }

    .order-summary-table td {
        padding: 15px 0;
        border-bottom: 1px solid #f9f9f9;
        color: #444;
    }

    .summary-footer {
        background-color: #fcfcfc;
        padding: 20px;
        border-radius: 10px;
        margin-top: 20px;
    }

    .summary-line {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .summary-line.total {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 2px solid #eee;
        font-size: 1.25rem;
        font-weight: 800;
        color: #f72f35;
    }

    .payment-section {
        background-color: #fdfdfd;
        padding: 25px;
        border-radius: 12px;
        border: 1px solid #eee;
    }

    .stripe-element-container {
        background: white;
        padding: 12px;
        border: 1px solid #ced4da;
        border-radius: 5px;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .stripe-element-container.StripeElement--focus {
        border-color: #f72f35;
        box-shadow: 0 0 0 0.2rem rgba(247, 47, 53, 0.25);
    }

    .btn-pay {
        background-color: #f72f35;
        border: none;
        border-radius: 5px;
        color: white;
        font-weight: 700;
        padding: 15px;
        width: 100%;
        margin-top: 25px;
        transition: background-color 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-pay:hover {
        background-color: #d6282d;
        color: white;
    }

    .btn-pay:disabled {
        background-color: #ccc;
        cursor: not-allowed;
    }
</style>

<div class="checkout-container">
    <div class="container">
        <div class="checkout-card">
            <div class="checkout-header">
                <h2><i class="fas fa-lock me-2"></i>Secure Checkout</h2>
            </div>
            <div class="checkout-body">
                <div class="row">
                    <div class="col-lg-7">
                        <h3 class="section-title">Order Summary</h3>
                        <div class="table-responsive">
                            <table class="order-summary-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@item.Product.ProductName</div>
                                            </td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">&pound;@decimal.Round(item.Product.Price, 2, MidpointRounding.AwayFromZero).ToString("N2")</td>
                                            <td class="text-end fw-bold"> &pound;@((decimal.Round(item.Product.Price, 2, MidpointRounding.AwayFromZero) * item.Quantity).ToString("N2"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="summary-footer">
                            <div class="summary-line">
                                <span>Subtotal</span>
                                <span>&pound;@Model.TotalCost.ToString("N2")</span>
                            </div>
                            <div class="summary-line">
                                <span>Shipping</span>
                                <span>&pound;@ViewBag.ShippingCost.ToString("N2")</span>
                            </div>
                            <div class="summary-line total">
                                <span>Order Total</span>
                                <span>&pound;@ViewBag.TotalAmount.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5 mt-4 mt-lg-0">
                        <div class="payment-section">
                            <h3 class="section-title">Payment Details</h3>
                            <p class="text-muted small mb-4">Complete your purchase by providing your payment details securely.</p>

                            <form asp-controller="Order" asp-action="ProcessPayment" method="post" id="payment-form">
                                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                                <div class="form-group mb-3">
                                    <label for="card-element" class="form-label fw-bold">Credit or Debit Card</label>
                                    <div id="card-element" class="stripe-element-container">
                                        <!-- A Stripe Element will be inserted here. -->
                                    </div>
                                    <!-- Used to display form errors. -->
                                    <div id="card-errors" role="alert" class="text-danger mt-2 small"></div>
                                </div>

                                <button class="btn btn-pay" id="submit-button">
                                    Pay &pound;@ViewBag.TotalAmount.ToString("N2") Now
                                </button>
                            </form>

                            <div class="mt-4 text-center">
                                <img src="https://vikwp.com/images/plugins/stripe.png" alt="Powered by Stripe" width="120">
                            </div>
                        </div>
                        
                        <div class="mt-3 text-center d-flex flex-column gap-2">
                             <a href="@Url.Action("ShoppingCart", "ShoppingCart")" class="text-decoration-none text-muted small">
                                 <i class="fas fa-shopping-cart me-1"></i> Return to Shopping Cart
                             </a>
                             <a href="@Url.Action("Address", "Order")" class="text-decoration-none text-muted small">
                                 <i class="fas fa-arrow-left me-1"></i> Return to Shipping Address
                             </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Include Stripe.js library *@
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        // Initialize Stripe with the publishable key passed from the controller
        var stripe = Stripe('@ViewBag.PublishableKey');
        var elements = stripe.elements();

        // Custom styling for the Stripe Element
        var style = {
            base: {
                color: '#32325d',
                fontFamily: '"Helvetica Neue", Helvetica, sans-serif',
                fontSmoothing: 'antialiased',
                fontSize: '16px',
                '::placeholder': {
                    color: '#aab7c4'
                }
            },
            invalid: {
                color: '#fa755a',
                iconColor: '#fa755a'
            }
        };

        // Create an instance of the card Element
        var card = elements.create('card', { style: style });

        // Add an instance of the card Element into the `card-element` <div>
        card.mount('#card-element');

        // Add focus/blur classes for styling
        card.on('focus', function() {
            document.getElementById('card-element').classList.add('StripeElement--focus');
        });
        card.on('blur', function() {
            document.getElementById('card-element').classList.remove('StripeElement--focus');
        });

        // Handle real-time validation errors from the card Element
        card.addEventListener('change', function (event) {
            var displayError = document.getElementById('card-errors');
            if (event.error) {
                displayError.textContent = event.error.message;
            } else {
                displayError.textContent = '';
            }
        });

        // Handle form submission
        var form = document.getElementById('payment-form');
        form.addEventListener('submit', function (event) {
            event.preventDefault();

            // Disable the submit button to prevent multiple clicks
            document.getElementById('submit-button').disabled = true;

            // Create a token from the card details via Stripe API
            stripe.createToken(card).then(function (result) {
                if (result.error) {
                    // Inform the user if there was an error
                    var errorElement = document.getElementById('card-errors');
                    errorElement.textContent = result.error.message;
                    // Re-enable the submit button
                    document.getElementById('submit-button').disabled = false;
                } else {
                    // Send the token to your server
                    stripeTokenHandler(result.token);
                }
            });
        });

        // Submit the form with the token ID
        function stripeTokenHandler(token) {
            var form = document.getElementById('payment-form');
            var hiddenInput = document.createElement('input');
            hiddenInput.setAttribute('type', 'hidden');
            hiddenInput.setAttribute('name', 'stripeToken');
            hiddenInput.setAttribute('value', token.id);
            form.appendChild(hiddenInput);

            // Submit the form
            form.submit();
        }
    </script>
}