@model TurboTrackModels_Dotnet_Core.ViewModels.ProductSalesReportViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Product Sales Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h2 { text-align: center; color: #333; }
        .info { margin-bottom: 20px; text-align: right; font-size: 0.9em; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        th { background-color: #f4f4f4; }
        .text-right { text-align: right; }
        .total-row { font-weight: bold; background-color: #eee; }
        .btn { display: inline-block; padding: 6px 12px; margin-bottom: 0; font-size: 14px; font-weight: 400; line-height: 1.42857143; text-align: center; white-space: nowrap; vertical-align: middle; cursor: pointer; border: 1px solid transparent; border-radius: 4px; text-decoration: none; }
        .btn-primary { color: #fff; background-color: #337ab7; border-color: #2e6da4; }
        .no-print { margin-bottom: 20px; }
    </style>
</head>
<body>
    @if (ViewContext.RouteData.Values["action"] as string == "ProductSalesReport")
    {
        <div class="no-print">
            <a asp-controller="SalesManager" asp-action="DownloadProductSalesReportExcel" class="btn btn-primary">Download Excel</a>
            <a href="@Url.Action("Dashboard", "SalesManager")" class="btn" style="background-color: #ccc;">Back to Dashboard</a>
        </div>
    }

    <h2>Product Sales Report</h2>
    <div class="info">
        Generated on: @Model.GeneratedAt.ToString("f")
    </div>

    <table>
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Product Name</th>
                <th class="text-right">Stock Level</th>
                <th class="text-right">Quantity Sold</th>
                <th class="text-right">Total Revenue</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ProductSales)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td>@item.ProductName</td>
                    <td class="text-right">@item.CurrentStockLevel</td>
                    <td class="text-right">@item.TotalQuantitySold</td>
                    <td class="text-right">@item.TotalRevenue.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="total-row">
                <td colspan="3">Totals</td>
                <td class="text-right">@Model.ProductSales.Sum(s => s.TotalQuantitySold)</td>
                <td class="text-right">@Model.ProductSales.Sum(s => s.TotalRevenue).ToString("C")</td>
            </tr>
        </tfoot>
    </table>
</body>
</html>
