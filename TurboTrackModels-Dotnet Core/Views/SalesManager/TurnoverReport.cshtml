@model TurboTrackModels_Dotnet_Core.ViewModels.TurnoverReportViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Turnover Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h2 { text-align: center; color: #333; }
        .info { margin-bottom: 20px; text-align: right; font-size: 0.9em; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        th { background-color: #f4f4f4; }
        .text-right { text-align: right; }
        .total-row { font-weight: bold; background-color: #eee; }
        .btn { display: inline-block; padding: 6px 12px; margin-bottom: 0; font-size: 14px; font-weight: 400; line-height: 1.42857143; text-align: center; white-space: nowrap; vertical-align: middle; cursor: pointer; border: 1px solid transparent; border-radius: 4px; text-decoration: none; }
        .btn-primary { color: #fff; background-color: #337ab7; border-color: #2e6da4; }
        .no-print { margin-bottom: 20px; }
    </style>
</head>
<body>
    @if (ViewContext.RouteData.Values["action"] as string == "TurnoverReport")
    {
        <div class="no-print">
            <form method="get" style="display: inline-block;">
                <label>Start Date:</label>
                <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" style="padding: 5px;" />
                <label>End Date:</label>
                <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" style="padding: 5px;" />
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>
            <a href="@Url.Action("DownloadTurnoverReportExcel", new { startDate = Model.StartDate, endDate = Model.EndDate })" class="btn" style="background-color: #5cb85c; color: white;">Download Excel</a>
            <a href="@Url.Action("Dashboard", "SalesManager")" class="btn" style="background-color: #ccc;">Back to Dashboard</a>
        </div>
    }

    <h2>Turnover Report</h2>
    <div class="info">
        Generated on: @DateTime.Now.ToString("f")<br />
        Period: @Model.StartDate.ToShortDateString() - @Model.EndDate.ToShortDateString()
    </div>

    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th class="text-right">Order Count</th>
                <th class="text-right">Turnover</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var day in Model.DailyTurnovers)
            {
                <tr>
                    <td>@day.Date.ToShortDateString()</td>
                    <td class="text-right">@day.OrderCount</td>
                    <td class="text-right">@day.Amount.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="total-row">
                <td colspan="2">Total Turnover</td>
                <td class="text-right">@Model.TotalTurnover.ToString("C")</td>
            </tr>
        </tfoot>
    </table>
</body>
</html>
