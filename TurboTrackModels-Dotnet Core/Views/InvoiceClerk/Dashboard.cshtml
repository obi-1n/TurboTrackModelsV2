@model List<TurboTrackModels_Dotnet_Core.Models.Order>

@{
    ViewBag.Title = "Invoice Clerk Dashboard";
}

@inject Microsoft.AspNetCore.Identity.UserManager<TurboTrackModels_Dotnet_Core.Models.User> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var firstName = currentUser?.FirstName ?? string.Empty;
}

<div class="container mt-5">
    @if (!string.IsNullOrEmpty(firstName))
    {
        <h2 class="text-center">Hi @firstName</h2>
        <br />
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title"><i class="fas fa-filter me-2"></i>Filter Invoices</h5>
            @using (Html.BeginForm("Dashboard", "InvoiceClerk", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-4">
                    <label for="filterDate" class="form-label">Order Date</label>
                    <input type="date" name="filterDate" id="filterDate" class="form-control" value="@ViewBag.FilterDate" />
                </div>
                <div class="col-md-4">
                    <label for="filterUsername" class="form-label">Username</label>
                    <input type="text" name="filterUsername" id="filterUsername" class="form-control" placeholder="Search by username..." value="@ViewBag.FilterUsername" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Filter</button>
                    <a href="@Url.Action("Dashboard")" class="btn btn-outline-secondary"><i class="fas fa-undo"></i> Clear</a>
                </div>
            }
        </div>
    </div>

    @* Check if there are any orders in the system *@
    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            <p>No orders found in the system.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        @* Table Headers *@
                        <th>Order ID</th>
                        <th>Ordered By</th>
                        <th>Order Date</th>
                        <th>Status</th>
                        <th>Total Cost</th>
                        <th>Items</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        @* Main Order Row *@
                        <tr>
                            <td><strong>#@order.OrderId</strong></td>
                            @* Display the username of the customer who placed the order *@
                            <td>@(order.Customer?.User?.UserName ?? "N/A")</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @* Display a color-coded badge based on the order status *@
                                @switch (order.Status.ToString())
                                {
                                    case "Pending":
                                        <span class="badge bg-warning text-dark">Pending</span>
                                        break;
                                    case "Processing":
                                        <span class="badge bg-info">Processing</span>
                                        break;
                                    case "Shipped":
                                        <span class="badge bg-primary">Shipped</span>
                                        break;
                                    case "Delivered":
                                        <span class="badge bg-success">Delivered</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td>&pound;@order.TotalCost.ToString("F2")</td>
                            <td>@order.OrderItems.Count item(s)</td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Order actions">
                                    @* Button to toggle the detailed view of order items *@
                                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#order-@order.OrderId" aria-expanded="false" title="View order items">
                                        View Details
                                    </button>
                                    
                                    @* Link to download the invoice PDF *@
                                    <a href="@Url.Action("DownloadInvoice", "InvoiceClerk", new { orderId = order.OrderId })" 
                                       class="btn btn-sm btn-outline-success" 
                                       title="Download invoice as PDF">
                                        <i class="fas fa-file-invoice-dollar"></i> Invoice
                                    </a>
                                </div>
                            </td>
                        </tr>

                        @* Collapsible Row for Order Details *@
                        <tr>
                            <td colspan="7">
                                <div class="collapse" id="order-@order.OrderId">
                                    <div class="card card-body">
                                        <h6>Order Items:</h6>
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th>Quantity</th>
                                                    <th>Unit Price</th>
                                                    <th>Subtotal</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @* List each item in the order *@
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <tr>
                                                        <td>@item.Product.ProductName</td>
                                                        <td>@item.Quantity</td>
                                                        <td>&pound;@item.UnitPrice.ToString("F2")</td>
                                                        <td>&pound;@((item.Quantity * item.UnitPrice).ToString("F2"))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <hr />
                                        <strong>Shipping: &pound;@order.ShippingCost.ToString("F2")</strong><br />
                                        <strong>Order Total: &pound;@order.TotalCost.ToString("F2")</strong>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    /* Add hover effect to table rows */
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    /* Style for the action button group */
    .btn-group {
        display: flex;
        gap: 0.5rem;
    }
</style>

@section Scripts {
    @* Load FontAwesome for icons *@
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}
