<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TurboTrack Models</title>
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/Site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">TurboTrack Models</a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li><a class="nav-link" asp-controller="ShoppingCart" asp-action="ShoppingCart">Cart</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <li><a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                        }
                        if (User.IsInRole("Customer"))
                        {
                            <li><a class="nav-link" asp-controller="Customer" asp-action="OrderHistory">Order History</a></li>
                            <li><a class="nav-link" asp-controller="Customer" asp-action="RequestReturns">Request Returns</a></li>
                            <li><a class="nav-link" asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                        }
                        if (User.IsInRole("Invoice Clerk"))
                        {
                            <li><a class="nav-link" asp-controller="InvoiceClerk" asp-action="Dashboard">Dashboard</a></li>
                        }
                        if (User.IsInRole("Sales Manager"))
                        {
                            <li><a class="nav-link" asp-controller="SalesManager" asp-action="Dashboard">Dashboard</a></li>
                        }
                        if (User.IsInRole("Assistant Manager"))
                        {
                            <li><a class="nav-link" asp-controller="AssistantManager" asp-action="Dashboard">Dashboard</a></li>
                        }
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - TurboTrack Models</p>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
