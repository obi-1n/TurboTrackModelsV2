@model List<TurboTrackModels_Dotnet_Core.Models.WishlistItem>
@{
    ViewBag.Title = "Wishlist";
}

<div class="container py-4">
    <h1 class="mb-4">My Wishlist</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Your wishlist is empty. Browse the store and add products you want to save.
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse products</a>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                        {
                            <img src="@Url.Content(item.Product.ImageUrl)" class="card-img-top"
                                 alt="@item.Product.ProductName" style="height: 220px; object-fit: cover;" />
                        }
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5 card-title">@item.Product.ProductName</h2>
                            <p class="fw-bold">&pound;@item.Product.Price.ToString("N2")</p>
                            <p class="text-muted">Added @item.DateAdded.ToLocalTime().ToString("dd MMM yyyy")</p>
                            <div class="mt-auto d-flex gap-2">
                                <form asp-controller="ShoppingCart" asp-action="Add" method="post">
                                    <input type="hidden" name="id" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-primary">Add to basket</button>
                                </form>
                                <form asp-controller="Wishlist" asp-action="Remove" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-outline-danger">Remove</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
