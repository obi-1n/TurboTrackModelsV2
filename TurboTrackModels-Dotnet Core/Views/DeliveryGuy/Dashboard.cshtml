@model List<TurboTrackModels_Dotnet_Core.Models.Order>

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_DeliveryGuyLayout.cshtml";
}

@inject Microsoft.AspNetCore.Identity.UserManager<TurboTrackModels_Dotnet_Core.Models.User> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var firstName = currentUser?.FirstName ?? string.Empty;
}

<div class="container mt-4">
    @if (!string.IsNullOrEmpty(firstName))
    {
        <h2 class=" text-center">Hi @firstName</h2>
        <br />
    }

    <hr />

    <h3 class="text-center">Shipped Orders</h3>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            <p>There are no shipped orders at the moment.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Order Date</th>
                        <th>Customer</th>
                        <th>Total Cost</th>
                        <th>Items</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>#@order.OrderId</strong></td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(order.Customer != null && order.Customer.User != null ? $"{order.Customer.User.FirstName} {order.Customer.User.LastName}" : "N/A")</td>
                            <td>&pound;@order.TotalCost.ToString("F2")</td>
                            <td>@order.OrderItems.Count item(s)</td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Order actions">
                                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#order-@order.OrderId" aria-expanded="false">
                                        View Details
                                    </button>

                                    <form asp-controller="DeliveryGuy" asp-action="MarkAsDelivered"
                                          asp-route-orderId="@order.OrderId" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            Mark as Delivered
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>

                        @* Collapsible Details Row *@
                        <tr>
                            <td colspan="6" class="p-0">
                                <div class="collapse" id="order-@order.OrderId">
                                    <div class="card card-body m-2">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <h6>Customer Details:</h6>
                                                <p class="mb-1"><strong>Name:</strong> @(order.Customer != null && order.Customer.User != null ? $"{order.Customer.User.FirstName} {order.Customer.User.LastName}" : "N/A")</p>
                                                <p class="mb-3">
                                                    <strong>Shipping Address:</strong><br />
                                                    @if (order.Customer != null)
                                                    {
                                                        @order.Customer.Street<br />
                                                        @order.Customer.Town<br />
                                                        @order.Customer.PostCode
                                                    }
                                                    else
                                                    {
                                                        <span>N/A</span>
                                                    }
                                                </p>
                                            </div>
                                        </div>

                                        <h6>Order Items:</h6>
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th>Quantity</th>
                                                    <th>Unit Price</th>
                                                    <th>Subtotal</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <tr>
                                                        <td>@item.Product.ProductName</td>
                                                        <td>@item.Quantity</td>
                                                        <td>&pound;@item.UnitPrice.ToString("F2")</td>
                                                        <td>&pound;@((item.Quantity * item.UnitPrice).ToString("F2"))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <hr />
                                        <strong>Shipping: &pound;@order.ShippingCost.ToString("F2")</strong><br />
                                        <strong>Order Total: &pound;@order.TotalCost.ToString("F2")</strong>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .btn-group {
        display: flex;
        gap: 0.5rem;
    }
</style>
