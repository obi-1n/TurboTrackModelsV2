@model TurboTrackModels_Dotnet_Core.ViewModels.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<style>
    .password-page {
        max-width: 720px;
        margin: 3rem auto;
    }

    .password-card {
        overflow: hidden;
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 0.75rem 2.5rem rgba(20, 33, 48, 0.12);
    }

    .password-header {
        padding: 2rem;
        color: #fff;
        background: linear-gradient(120deg, #c91f2b, #f72f35);
    }

    .password-header h1 {
        margin-bottom: 0.5rem;
        font-size: clamp(1.7rem, 3vw, 2.1rem);
        font-weight: 750;
    }

    .password-header p {
        margin: 0;
        color: rgba(255, 255, 255, 0.85);
    }

    .password-content {
        padding: clamp(1.25rem, 4vw, 2rem);
    }

    .password-content .form-label {
        font-weight: 600;
    }

    .password-content .form-control {
        min-height: 46px;
    }

</style>

<main class="container password-page">
    <section class="card password-card">
        <header class="password-header">
            <h1>Change your password</h1>
            <p>Enter your current password, then choose a new one.</p>
        </header>

        <div class="password-content">
            <form asp-controller="Manage" asp-action="ChangePassword" method="post">
                
                <div class="mb-3">
                    <label asp-for="OldPassword" class="form-label">Current password</label>
                    <input asp-for="OldPassword" class="form-control" autocomplete="current-password"
                           placeholder="Enter your current password" />
                    <span asp-validation-for="OldPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New password</label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password"
                           placeholder="Enter a new password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm new password</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"
                           placeholder="Enter the new password again" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 pt-3 border-top">
                    <a asp-controller="Manage" asp-action="Index" class="btn btn-outline-secondary">
                        Back to account settings
                    </a>
                    <button type="submit" class="btn btn-danger px-4">Update password</button>
                </div>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
