@model TurboTrackModels_Dotnet_Core.ViewModels.IndexViewModel
@{
    ViewBag.Title = "Account settings";
    var statusMessage = Model.StatusMessage switch
    {
        "ChangePasswordSuccess" => "Your password was changed successfully.",
        "SetPasswordSuccess" => "Your password was created successfully.",
        "SetTwoFactorSuccess" => "Your two-factor authentication settings were updated.",
        "RemovePhoneSuccess" => "Your phone number was removed.",
        _ => Model.StatusMessage
    };
}

<style>
    .account-page {
        max-width: 900px;
        margin: 3rem auto;
    }

    .account-card {
        overflow: hidden;
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 0.75rem 2.5rem rgba(20, 33, 48, 0.12);
    }

    .account-header {
        padding: 2rem;
        color: #fff;
        background: linear-gradient(120deg, #c91f2b, #f72f35);
    }

    .account-header h1 {
        margin-bottom: 0.5rem;
        font-size: clamp(1.7rem, 3vw, 2.1rem);
        font-weight: 750;
    }

    .account-header p {
        margin: 0;
        color: rgba(255, 255, 255, 0.85);
    }

    .account-content {
        padding: clamp(1.25rem, 4vw, 2rem);
    }

    .setting-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.25rem 0;
        border-bottom: 1px solid #e9ecef;
    }

    .setting-row:last-child {
        border-bottom: 0;
    }

    .setting-title {
        margin-bottom: 0.25rem;
        font-weight: 650;
    }

    .setting-description {
        margin: 0;
        color: #6c757d;
        font-size: 0.925rem;
    }

    @@media (max-width: 575.98px) {
        .setting-row {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<main class="container account-page">
    <section class="card account-card">
        <header class="account-header">
            <h1>Account settings</h1>
            <p>Manage your password and sign-in options.</p>
        </header>

        <div class="account-content">
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="alert alert-success" role="status">@statusMessage</div>
            }

            <div class="setting-row">
                <div>
                    <div class="setting-title">Password</div>
                    <p class="setting-description">
                        @(Model.HasPassword
                            ? "Keep your account secure with a strong, up-to-date password."
                            : "Add a password so you can sign in with your account credentials.")
                    </p>
                </div>
                @if (Model.HasPassword)
                {
                    <a asp-controller="Manage" asp-action="ChangePassword" class="btn btn-outline-danger">
                        Change password
                    </a>
                }
                else
                {
                    <a asp-controller="Manage" asp-action="SetPassword" class="btn btn-danger">
                        Create password
                    </a>
                }
            </div>

        </div>
    </section>
</main>
