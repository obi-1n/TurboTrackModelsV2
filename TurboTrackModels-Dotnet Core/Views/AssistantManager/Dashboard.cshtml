
@{
    ViewBag.Title = "Assistant Manager Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center">Assistant Manager Dashboard</h2>
    <hr />
    
    <div class="row mt-4 justify-content-center">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Manage Products</h5>
                    <p class="card-text">Add new products or edit existing product details and stock levels.</p>
                    @Html.ActionLink("Go to Product Management", "ProductList", "AssistantManager", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Manage Returns</h5>
                    <p class="card-text">Process return requests submitted by customers.</p>
                    @Html.ActionLink("Manage Returns", "ManageReturns", "AssistantManager", null, new { @class = "btn btn-warning" })
                </div>
            </div>
        </div>
    </div>
</div>
