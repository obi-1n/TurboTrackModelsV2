@model List<TurboTrackModels_Dotnet_Core.Models.Order>

@{
    ViewBag.Title = "Manage Returns";
}

<div class="container mt-5">
    <h2>Manage Return Requests</h2>
    <p class="text-muted">Process customer returns and resolve payments awaiting a refund.</p>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            <p>No pending returns or refunds found.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Order Date</th>
                        <th>Details</th>
                        <th>Total Cost</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>#@order.OrderId</strong></td>
                            <td>
                                @if (order.Customer != null && order.Customer.User != null)
                                {
                                    @order.Customer.User.Email
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (order.Status == TurboTrackModels_Dotnet_Core.Models.OrderStatus.RefundPending)
                                {
                                    <span class="badge bg-warning text-dark">Refund pending</span>
                                }
                                else
                                {
                                    <div style="max-width: 300px; white-space: pre-wrap;">@order.ReturnReason</div>
                                }
                            </td>
                            <td>&pound;@order.TotalCost.ToString("F2")</td>
                            <td>
                                @if (order.Status == TurboTrackModels_Dotnet_Core.Models.OrderStatus.RefundPending)
                                {
                                    <form asp-controller="AssistantManager" asp-action="RetryRefund"
                                          asp-route-orderId="@order.OrderId" method="post">
                                        <button type="submit" class="btn btn-sm btn-warning">
                                            Retry Refund
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="AssistantManager" asp-action="MarkAsReturned"
                                          asp-route-orderId="@order.OrderId" method="post">
                                        <button type="submit" class="btn btn-sm btn-success"
                                                onclick="return confirm('Refund this order and mark it as returned?')">
                                            Refund &amp; Mark Returned
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
