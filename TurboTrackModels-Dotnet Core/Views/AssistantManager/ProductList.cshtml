@model IEnumerable<TurboTrackModels_Dotnet_Core.Models.Product>

@{
    ViewBag.Title = "Product Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Product Management</h2>
        @Html.ActionLink("Add New Product", "AddProduct", null, new { @class = "btn btn-success shadow-sm" })
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Product</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Stock Level</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="me-3">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@Url.Content(item.ImageUrl)" alt="@item.ProductName" class="rounded shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded bg-light d-flex align-items-center justify-content-center shadow-sm" style="width: 60px; height: 60px;">
                                                    <i class="bi bi-image text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.ProductName</div>
                                            <small class="text-muted">ID: @item.ProductId</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 300px;" title="@item.Description">
                                        @item.Description
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold">&pound;@item.Price.ToString("N2")</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @{
                                            var stockClass = "bg-success";
                                            if (item.StockLevel <= 5) { stockClass = "bg-danger"; }
                                            else if (item.StockLevel <= 20) { stockClass = "bg-warning text-dark"; }
                                        }
                                        <span class="badge @stockClass rounded-pill me-2" style="min-width: 40px;">
                                            @item.StockLevel
                                        </span>
                                        <small class="text-muted">units</small>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        @Html.ActionLink("Edit", "EditProduct", new { id = item.ProductId }, new { @class = "btn btn-sm btn-outline-primary" })
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete('@item.ProductId', '@item.ProductName')">
                                            Delete
                                        </button>
                                    </div>
                                    <form asp-controller="AssistantManager" asp-action="DeleteProduct"
                                          asp-route-id="@item.ProductId" method="post"
                                          id="deleteForm-@item.ProductId" style="display:none;"></form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        @if (User.IsInRole("Stock Control Manager"))
        {
            @Html.ActionLink("Back to Dashboard", "Dashboard", "StockManager", null, new { @class = "btn btn-link text-secondary p-0 text-decoration-none" })
        }
        else
        {
            @Html.ActionLink("Back to Dashboard", "Dashboard", null, new { @class = "btn btn-link text-secondary p-0 text-decoration-none" })
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        .table thead th {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            border-top: none;
        }
        .table td {
            font-size: 0.95rem;
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
        .btn-group .btn {
            padding: 0.375rem 0.75rem;
        }
    </style>
}

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            if (confirm("Are you sure you want to delete product: " + name + " (ID: " + id + ")?")) {
                document.getElementById('deleteForm-' + id).submit();
            }
        }
    </script>
}
