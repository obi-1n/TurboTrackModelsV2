@model TurboTrackModels_Dotnet_Core.ViewModels.ReturnRequestViewModel

@{
    ViewBag.Title = "Submit Return Request";
}

<div class="container mt-5">
    <h2>Return Order #@Model.OrderId</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    Order Details
                </div>
                <div class="card-body">
                    <p><strong>Order Date:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Total Cost:</strong> &pound;@Model.TotalCost.ToString("F2")</p>
                    
                    <h5 class="mt-4">Items in this Order</h5>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderItems != null)
                            {
                                foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>@(item.Product != null ? item.Product.ProductName : item.ProductId)</td>
                                        <td>@item.Quantity</td>
                                        <td>&pound;@item.UnitPrice.ToString("F2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.OrderId)
                @Html.HiddenFor(m => m.OrderDate)
                @Html.HiddenFor(m => m.TotalCost)

                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.ReturnReason, new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.ReturnReason, new { @class = "form-control", rows = "4", placeholder = "Please tell us why you are returning this order..." })
                    @Html.ValidationMessageFor(m => m.ReturnReason, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-danger">Submit Return Request</button>
                    <a href="@Url.Action("RequestReturns")" class="btn btn-secondary">Cancel</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
